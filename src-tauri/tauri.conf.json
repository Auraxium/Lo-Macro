{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lo-macro-v3",
  "version": "0.1.0",
  "identifier": "com.administrator.lo-macro-v3",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lo-macro-v3",
        "width": 800,
        "height": 600,
        "label": "main",
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["main.exe", "keyTracker.exe"]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": ["https://misc.auraxium.dev/file?name=latest_lm.json"],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0M0NERDA4MDc1QUNERDIKUldUU3pWb0hDTjA4ZE94am52RlIvUFllMS9vRWRIV1lJbUxDSGlUMEJpQjVjZklJMkJZRlNPSjcK",
      "windows" : {
        "installMode": "passive"
      }
    }
  }
}
